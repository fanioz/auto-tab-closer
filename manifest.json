{
  "manifest_version": 3,
  "name": "Tab Custodian — Auto Close Idle Tabs",
  "version": "1.0.0",
  "description": "Automatically closes tabs you forgot about — frees memory, keeps you focused. Everything restorable.",
  "permissions": [
    "tabs",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
